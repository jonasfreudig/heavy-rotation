<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keys and tokens stay on this phone (no cloud backup, no device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
        <!-- The Last.fm history: Android's cap is 25 MB, a long history alone can pass it; the app imports it again. -->
        <exclude domain="database" path="history.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
